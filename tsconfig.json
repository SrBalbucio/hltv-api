{
  "compilerOptions": {
    "lib": [
      "es5",
      "es6",
      "ESNext",
      "dom",
      "dom.iterable",
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ESNext",
    "strict": false,
    "rootDir": "./src",
    "outDir": "build",
    "sourceMap": false,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts"
  ]
}
