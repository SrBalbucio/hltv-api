{
  "name": "hltv-api",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "docker-compose up -d && cross-env HEADLESS=false tsx watch --clear-screen=false ./src/index.ts",
    "dev:on": "cross-env HEADLESS=true tsx watch --clear-screen=false ./src/index.ts",
    "build": "tsc",
    "start": "cross-env HEADLESS=true node build/index.js",
    "time": "cross-env HEADLESS=false tsx ./src/time.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "puppeteer": "^25.15.0",
    "query-string": "^10.0.0",
    "redis": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "typescript": "^7.0.2"
  }
}
